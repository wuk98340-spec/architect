  "key_strategies": [
    {
      "strategy_name": "以白云山水组织大型会堂的地域形象",
      "design_problem": "大型会议中心容易成为尺度巨大但地域性薄弱的通用空间，需要在城市级公共活动中建立可识别的广州/白云意象。",
      "specific_approach": "以“白云山水，云山叠翠，时代国风”为主题，使用圆形屋顶、玻璃方盒、青花瓷顶、水体、水晶吊坠和琉璃墙等空间与材料线索。",
      "architectural_effect": "形成比普通会议中心更强的礼仪感和地域叙事，让中厅成为具有记忆点的公共核心。",
      "evidence": "澎湃新闻转载稿直接描述主题、圆形屋顶、玻璃方盒、青花瓷顶、水晶吊坠和琉璃墙。",
      "source_ids": [
        "s2"
      ],
      "related_image_ids": [
        "img_01",
        "img_02",
        "img_01"
      ],
      "transferable_lesson": "地域文化表达应落实到屋顶、界面、采光、水体和室内装置等空间层级，而不是停留在符号口号。"
    },
    {
      "strategy_name": "以中厅和廊院建立会议建筑的空间序列",
      "design_problem": "大型会展建筑人流量大、活动类型多，需要清晰的到达、停留、分流和转换空间。",
      "specific_approach": "以中厅、会展厅、多功能厅及配套构成功能骨架，并通过流水花园、移动廊院等组织公共空间体验。",
      "architectural_effect": "中厅承担集散、仪式和视觉核心，廊院缓冲不同功能区，降低超大尺度建筑的压迫感。",
      "evidence": "澎湃新闻转载稿说明建筑主要部分和移动廊院、流水花园等空间意象。",
      "source_ids": [
        "s2"
      ],
      "related_image_ids": [
        "img_01",
        "img_02"
      ],
      "transferable_lesson": "会议建筑的交通空间可以被设计为连续公共场景，而不仅是走廊。"
    },
    {
      "strategy_name": "用可变设备系统支持超级多功能厅",
      "design_problem": "会堂需要适应会议、展览、宴会、演出等不同活动，固定空间难以覆盖多种场景。",
      "specific_approach": "使用可调可变的天花、隔声间隔、灯光、音响和 450 个升降台，配合大跨度厅堂空间。",
      "architectural_effect": "超级多功能厅从单一大厅转化为可重组的活动平台，提高大型公共建筑的运营弹性。",
      "evidence": "澎湃新闻转载稿提到可变设备系统、450 个升降台和快速调节场地。",
      "source_ids": [
