{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture Case Package",
  "type": "object",
  "required": [
    "project_name",
    "architects",
    "location",
    "year",
    "program",
    "status",
    "case_type",
    "disambiguation_status",
    "disambiguation_candidates",
    "information_confidence",
    "incomplete_reason",
    "one_sentence_summary",
    "key_facts",
    "design_concept",
    "key_strategies",
    "spatial_ideas",
    "materials_structure",
    "site_context",
    "image_metadata",
    "download_mode",
    "source_quality",
    "sources",
    "uncertain_or_conflicting_info"
  ],
  "additionalProperties": false,
  "properties": {
    "project_name": {
      "type": "string"
    },
    "architects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "location": {
      "type": "string"
    },
    "year": {
      "type": "string"
    },
    "program": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "case_type": {
      "type": "string",
      "description": "Cultural, education, hotel, housing, commercial, renovation, rural/tourism, green building, or another explicit type."
    },
    "disambiguation_status": {
      "enum": [
        "confirmed",
        "high_confidence",
        "ambiguous_waiting_for_user",
        "not_needed"
      ]
    },
    "disambiguation_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/disambiguationCandidate"
      }
    },
    "information_confidence": {
      "enum": [
        "high",
        "medium",
        "limited",
        "low"
      ]
    },
    "incomplete_reason": {
      "type": "string"
    },
    "one_sentence_summary": {
      "type": "string"
    },
    "key_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "design_concept": {
      "type": "object",
      "required": [
        "sourced_concept",
        "ai_synthesis",
        "source_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "sourced_concept": {
          "type": "string"
        },
        "ai_synthesis": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "key_strategies": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/strategy"
      }
    },
    "spatial_ideas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      }
    },
    "materials_structure": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      }
    },
    "site_context": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/note"
      }
    },
    "image_metadata": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/imageMetadata"
      }
    },
    "download_mode": {
      "enum": [
        "not_requested",
        "requested",
        "partial",
        "completed"
      ]
    },
    "source_quality": {
      "$ref": "#/$defs/sourceQuality"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "uncertain_or_conflicting_info": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uncertainty"
      }
    },
    "technical_metrics": {
      "$ref": "#/$defs/technicalMetrics"
    },
    "site_information": {
      "$ref": "#/$defs/siteInformation"
    },
    "conceptual_exploration": {
      "$ref": "#/$defs/conceptualExploration"
    },
    "architectural_language_generation": {
      "$ref": "#/$defs/architecturalLanguageGeneration"
    },
    "construction_quality_control": {
      "$ref": "#/$defs/constructionQualityControl"
    },
    "design_lessons": {
      "$ref": "#/$defs/designLessons"
    }
  },
  "$defs": {
    "evidenceNote": {
      "type": "object",
      "required": [
        "text",
        "evidence_type",
        "source_ids",
        "related_image_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "evidence_type": {
          "enum": [
            "sourced",
            "synthesis",
            "missing",
            "conflict"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_image_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metricValue": {
      "type": "object",
      "required": [
        "value",
        "unit",
        "confidence",
        "source_ids",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "unit": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "confirmed",
            "reported",
            "limited",
            "unknown",
            "conflicting"
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "technicalMetrics": {
      "type": "object",
      "required": [
        "site_area",
        "building_area",
        "height",
        "floors",
        "far",
        "building_density",
        "structure_system",
        "main_materials",
        "client",
        "photography_drawing_credits",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "site_area": {
          "$ref": "#/$defs/metricValue"
        },
        "building_area": {
          "$ref": "#/$defs/metricValue"
        },
        "height": {
          "$ref": "#/$defs/metricValue"
        },
        "floors": {
          "$ref": "#/$defs/metricValue"
        },
        "far": {
          "$ref": "#/$defs/metricValue"
        },
        "building_density": {
          "$ref": "#/$defs/metricValue"
        },
        "structure_system": {
          "$ref": "#/$defs/metricValue"
        },
        "main_materials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceNote"
          }
        },
        "client": {
          "$ref": "#/$defs/metricValue"
        },
        "photography_drawing_credits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceNote"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "siteInformation": {
      "type": "object",
      "required": [
        "location_role",
        "natural_environment",
        "cultural_environment",
        "terrain_conditions",
        "roads_and_access",
        "surrounding_buildings",
        "served_users",
        "core_site_tension"
      ],
      "additionalProperties": false,
      "properties": {
        "location_role": {
          "$ref": "#/$defs/evidenceNote"
        },
        "natural_environment": {
          "$ref": "#/$defs/evidenceNote"
        },
        "cultural_environment": {
          "$ref": "#/$defs/evidenceNote"
        },
        "terrain_conditions": {
          "$ref": "#/$defs/evidenceNote"
        },
        "roads_and_access": {
          "$ref": "#/$defs/evidenceNote"
        },
        "surrounding_buildings": {
          "$ref": "#/$defs/evidenceNote"
        },
        "served_users": {
          "$ref": "#/$defs/evidenceNote"
        },
        "core_site_tension": {
          "$ref": "#/$defs/evidenceNote"
        }
      }
    },
    "conceptualExploration": {
      "type": "object",
      "required": [
        "diagnosis",
        "positioning",
        "strategy",
        "imagery_and_expression"
      ],
      "additionalProperties": false,
      "properties": {
        "diagnosis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceNote"
          }
        },
        "positioning": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceNote"
          }
        },
        "strategy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceNote"
          }
        },
        "imagery_and_expression": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceNote"
          }
        }
      }
    },
    "architecturalLanguageGeneration": {
      "type": "object",
      "required": [
        "function",
        "layout",
        "composition",
        "place_atmosphere"
      ],
      "additionalProperties": false,
      "properties": {
        "function": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceNote"
          }
        },
        "layout": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceNote"
          }
        },
        "composition": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceNote"
          }
        },
        "place_atmosphere": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceNote"
          }
        }
      }
    },
    "constructionQualityControl": {
      "type": "object",
      "required": [
        "construction_language",
        "materials_and_craft",
        "tectonic_logic",
        "performance_and_construction_control"
      ],
      "additionalProperties": false,
      "properties": {
        "construction_language": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceNote"
          }
        },
        "materials_and_craft": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceNote"
          }
        },
        "tectonic_logic": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceNote"
          }
        },
        "performance_and_construction_control": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceNote"
          }
        }
      }
    },
    "designLessons": {
      "type": "object",
      "required": [
        "transferable_methods",
        "avoid_copying",
        "analysis_diagram_potential"
      ],
      "additionalProperties": false,
      "properties": {
        "transferable_methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceNote"
          }
        },
        "avoid_copying": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceNote"
          }
        },
        "analysis_diagram_potential": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sourceQuality": {
      "type": "object",
      "required": [
        "has_primary_sources",
        "primary_sources_used_for_identity",
        "architecture_media_count",
        "wechat_valid_result_count",
        "zhihu_valid_result_count",
        "source_sufficiency_status",
        "secondary_source_heavy",
        "manual_review_needed",
        "identity_confirming_source_ids",
        "analysis_coverage"
      ],
      "additionalProperties": false,
      "properties": {
        "has_primary_sources": {
          "type": "boolean"
        },
        "primary_sources_used_for_identity": {
          "type": "boolean"
        },
        "architecture_media_count": {
          "type": "integer",
          "minimum": 0
        },
        "wechat_valid_result_count": {
          "type": "integer",
          "minimum": 0
        },
        "zhihu_valid_result_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_sufficiency_status": {
          "enum": [
            "sufficient",
            "partial",
            "insufficient",
            "ambiguous"
          ]
        },
        "secondary_source_heavy": {
          "type": "boolean"
        },
        "manual_review_needed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "identity_confirming_source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "analysis_coverage": {
          "type": "array",
          "items": {
            "enum": [
              "concept",
              "context",
              "program",
              "circulation",
              "facade_material",
              "structure_construction",
              "user_experience",
              "urban_relationship"
            ]
          }
        }
      }
    },
    "disambiguationCandidate": {
      "type": "object",
      "required": [
        "candidate_project",
        "location",
        "architects",
        "year",
        "type",
        "main_sources",
        "confidence",
        "question_for_user"
      ],
      "additionalProperties": false,
      "properties": {
        "candidate_project": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "architects": {
          "type": "string"
        },
        "year": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "main_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "string"
        },
        "question_for_user": {
          "type": "string"
        }
      }
    },
    "fact": {
      "type": "object",
      "required": [
        "label",
        "value",
        "source_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "strategy": {
      "type": "object",
      "required": [
        "strategy_name",
        "design_problem",
        "specific_approach",
        "architectural_effect",
        "evidence",
        "source_ids",
        "related_image_ids",
        "transferable_lesson"
      ],
      "additionalProperties": false,
      "properties": {
        "strategy_name": {
          "type": "string"
        },
        "design_problem": {
          "type": "string"
        },
        "specific_approach": {
          "type": "string"
        },
        "architectural_effect": {
          "type": "string"
        },
        "evidence": {
          "type": "string",
          "description": "Directly sourced, inferred synthesis, or mixed."
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_image_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transferable_lesson": {
          "type": "string"
        }
      }
    },
    "note": {
      "type": "object",
      "required": [
        "text",
        "source_ids",
        "related_image_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related_image_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "imageMetadata": {
      "type": "object",
      "required": [
        "id",
        "file_name",
        "image_type",
        "source_url",
        "source_site",
        "caption",
        "copyright_note",
        "recommended_use",
        "relevance_reason",
        "related_sections",
        "download_status",
        "failure_reason"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "file_name": {
          "type": "string"
        },
        "image_type": {
          "enum": [
            "01_hero",
            "02_site",
            "03_plan",
            "04_section",
            "05_elevation",
            "06_detail",
            "07_concept",
            "08_interior",
            "09_analysis"
          ]
        },
        "source_url": {
          "type": "string"
        },
        "source_site": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "copyright_note": {
          "type": "string"
        },
        "recommended_use": {
          "type": "string"
        },
        "relevance_reason": {
          "type": "string",
          "minLength": 1,
          "description": "The specific written claim or analysis point this image supports."
        },
        "related_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "download_status": {
          "enum": [
            "not_requested",
            "downloaded",
            "failed",
            "skipped"
          ]
        },
        "failure_reason": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "download_status": {
                "const": "downloaded"
              }
            }
          },
          "then": {
            "properties": {
              "file_name": {
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "download_status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "failure_reason": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "title",
        "url",
        "source_level",
        "publisher",
        "accessed_date",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "source_level": {
          "enum": [
            "level_a",
            "level_b",
            "level_c",
            "level_d"
          ]
        },
        "publisher": {
          "type": "string"
        },
        "accessed_date": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "uncertainty": {
      "type": "object",
      "required": [
        "topic",
        "description",
        "source_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "topic": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
