{
  "version": "2.0",
  "$schema": "https://framework-1258016615.tcloudbaseapp.com/schema/latest.json",
  "envId": "{{env.ENV_ID}}",
  "framework": {
    "name": "architect-research-platform",
    "plugins": {
      "api": {
        "use": "@cloudbase/framework-plugin-container",
        "inputs": {
          "serviceName": "architect-api",
          "servicePath": "/",
          "localPath": "./",
          "uploadType": "package",
          "dockerfilePath": "./Dockerfile",
          "containerPort": 8080,
          "isPublic": true,
          "mode": "low-cost",
          "cpu": 1,
          "mem": 2,
          "minNum": 1,
          "maxNum": 1,
          "envVariables": {
            "ARCHITECT_SERVICE_ROLE": "api",
            "ARCHITECT_API_HOST": "0.0.0.0",
            "ARCHITECT_DATA_ROOT": "/tmp/architect",
            "ARCHITECT_JOBS_ROOT": "/tmp/architect/worker-jobs",
            "ARCHITECT_CASE_PACKAGES_ROOT": "/tmp/architect/case-packages",
            "ARCHITECT_STORAGE_BACKEND": "cos",
            "ARCHITECT_COS_BUCKET": "{{env.ARCHITECT_COS_BUCKET}}",
            "ARCHITECT_COS_REGION": "{{env.ARCHITECT_COS_REGION}}",
            "ARCHITECT_COS_PREFIX": "{{env.ARCHITECT_COS_PREFIX}}",
            "ARCHITECT_COS_SECRET_ID": "{{env.ARCHITECT_COS_SECRET_ID}}",
            "ARCHITECT_COS_SECRET_KEY": "{{env.ARCHITECT_COS_SECRET_KEY}}",
            "ARCHITECT_LLM_PROVIDER": "deepseek",
            "ARCHITECT_LLM_MODEL": "deepseek-v4-flash",
            "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
            "ARCHITECT_LLM_TIMEOUT_SECONDS": "90",
            "ARCHITECT_LLM_MAX_TOKENS": "16000"
          }
        }
      },
      "researchWorker": {
        "use": "@cloudbase/framework-plugin-container",
        "inputs": {
          "serviceName": "architect-research-worker",
          "servicePath": "/",
          "localPath": "./",
          "uploadType": "package",
          "dockerfilePath": "./Dockerfile",
          "containerPort": 8080,
          "isPublic": false,
          "mode": "high-availability",
          "cpu": 1,
          "mem": 2,
          "minNum": 1,
          "maxNum": 1,
          "envVariables": {
            "ARCHITECT_SERVICE_ROLE": "worker",
            "ARCHITECT_DATA_ROOT": "/tmp/architect",
            "ARCHITECT_JOBS_ROOT": "/tmp/architect/worker-jobs",
            "ARCHITECT_CASE_PACKAGES_ROOT": "/tmp/architect/case-packages",
            "ARCHITECT_STORAGE_BACKEND": "cos",
            "ARCHITECT_COS_BUCKET": "{{env.ARCHITECT_COS_BUCKET}}",
            "ARCHITECT_COS_REGION": "{{env.ARCHITECT_COS_REGION}}",
            "ARCHITECT_COS_PREFIX": "{{env.ARCHITECT_COS_PREFIX}}",
            "ARCHITECT_COS_SECRET_ID": "{{env.ARCHITECT_COS_SECRET_ID}}",
            "ARCHITECT_COS_SECRET_KEY": "{{env.ARCHITECT_COS_SECRET_KEY}}",
            "ARCHITECT_LLM_PROVIDER": "deepseek",
            "ARCHITECT_LLM_MODEL": "deepseek-v4-flash",
            "DEEPSEEK_BASE_URL": "https://api.deepseek.com",
            "ARCHITECT_LLM_TIMEOUT_SECONDS": "90",
            "ARCHITECT_LLM_MAX_TOKENS": "16000"
          }
        }
      }
    }
  }
}
