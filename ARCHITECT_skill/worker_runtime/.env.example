# Real provider settings. Do not commit a populated .env file.
# Supported providers: openai, deepseek, fixture.
ARCHITECT_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
ARCHITECT_LLM_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
ARCHITECT_LLM_TIMEOUT_SECONDS=90
ARCHITECT_LLM_MAX_TOKENS=16000

# Durable storage target. Keep secrets out of this file and configure them in
# the CloudBase Run service environment.
ARCHITECT_STORAGE_BACKEND=cos
ARCHITECT_COS_BUCKET=
ARCHITECT_COS_REGION=
ARCHITECT_COS_PREFIX=architect
# Use either a role/temporary credential provider or the following server-only
# credentials. Never expose these values to the browser.
ARCHITECT_COS_SECRET_ID=
ARCHITECT_COS_SECRET_KEY=
