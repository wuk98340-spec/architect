{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture Case Disambiguation Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["job_id", "status", "candidates", "confirmation_question", "created_at"],
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["identity_confirmed", "confirmation_required"]},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "project_name", "location", "architect_or_studio", "year", "case_type", "source_urls", "confidence"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "project_name": {"type": "string", "minLength": 1},
          "location": {"type": "string", "minLength": 1},
          "architect_or_studio": {"type": "string", "minLength": 1},
          "year": {"type": "string", "minLength": 1},
          "case_type": {"type": "string", "minLength": 1},
          "source_urls": {"type": "array", "items": {"type": "string"}},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]}
        }
      }
    },
    "confirmation_question": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
